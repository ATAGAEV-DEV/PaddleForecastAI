# Скопируйте этот файл в .env и замените все заглушки своими значениями.
# Реальные токены и пароли храните только в .env, не добавляйте их в Git.

# Токен Telegram-бота. Получите его у @BotFather: https://t.me/BotFather
TG_TOKEN=replace_with_telegram_bot_token

# API-ключ OpenWeatherMap для получения прогноза погоды.
# Создайте ключ в личном кабинете: https://home.openweathermap.org/api_keys
WEATHER_API=replace_with_openweathermap_api_key

# Город или населённый пункт для прогноза погоды (на русском или английском).
# Если переменная не задана или пуста, используется Червлённая.
WEATHER_CITY=Червлённая

# API-токен выбранного ИИ-провайдера для генерации рекомендаций по погоде.
# Получите токен в личном кабинете провайдера, указанного в AI_PROVIDER_URL.
AI_TOKEN=replace_with_ai_provider_token

# Базовый URL OpenAI-совместимого API выбранного ИИ-провайдера.
# Пример для текущего провайдера; при смене провайдера замените адрес и AI_TOKEN.
AI_PROVIDER_URL=https://api.polza.ai/api/v1

# Единственное подключение PostgreSQL для асинхронного драйвера asyncpg.
# Замените пользователя, пароль, хост, порт и имя базы на свои значения.
# Спецсимволы в логине и пароле кодируйте для URL (например, @ -> %40).
DATABASE_URL=postgresql+asyncpg://db_user:replace_with_db_password@localhost:5432/paddleforecast

# Схема PostgreSQL для таблиц приложения. Если не указана или пуста, используется public.
# При выборе другой схемы заранее создайте её в базе данных.
DATABASE_SCHEMA=public
